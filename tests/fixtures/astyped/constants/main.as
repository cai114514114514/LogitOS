# aether: 3.0
# Every original system identity must survive native lowering. The host and
# guest gates compare this output with independently compiled ABI headers.
import bindings

def local() -> i64:
    SYS_WRITE = 902
    return SYS_WRITE

def capture(CAP_RAW: i64) -> Callable[[], i64]:
    def read() -> i64:
        return CAP_RAW
    return read

def constant[T](unused: T) -> i64:
    return SYS_WRITE

def main() -> None:
    assert bindings.value() == 1801
    assert local() == 902
    callback = capture(903)
    assert callback() == 903
    assert constant(4) == SYS_WRITE
    assert constant("中文") == SYS_WRITE
    print("CAP_FS_READ", CAP_FS_READ)
    print("CAP_FS_WRITE", CAP_FS_WRITE)
    print("CAP_NET", CAP_NET)
