# tests/asdiag.mk -- AetherScript diagnostics and the Studio host gates.
#
# test-as-diag, test-as-diag-negctl-guard and test-as-diag-negctl-line stood
# here until the A2 engine left (2026-09-16), and were missed by the change that
# tombstoned their siblings in the Makefile. The gate scored the messages of the
# AetherScript-written compiler, fsroot/as/lib/asc.as, against the C compiler's
# over 48 deliberately broken A2 programs (43 committed as
# tests/unit/asdiag/*.as.bad, the bulk classes generated by the script); its two
# controls perturbed a scratch copy of asc.as -- the expression-depth guard, and
# the "(line N)" suffix of every raise -- and required the gate to go red.
#
# asc.as was deleted with the engine, so from that day all three targets failed
# at their first cp/sed ("FAIL: no asc.as in fsroot/as/lib") before any message
# was scored -- reported by a host sweep on the macOS dev host, 2026-10-26. The
# corpus could not simply be re-pointed at A3: none of the 43 files starts with
# '# aether: 3.0', so the A3 compiler refuses each one wholesale with AS3302
# before reaching the error the file was written to provoke. A3 diagnostics are
# held by test-as-check, test-as-recovery and test-as-completion below; a scored
# A3 corpus would have to be written in A3 and is not rebuilt speculatively
# here. tests/unit/run-as-diag.sh and tests/unit/asdiag/ (the corpus and its
# CLASSES.txt) were deleted in the same change.

# The host exercises the same engine objects without any GUI/Logit syscalls.
$(BUILD)/asc: c/apps/as/common/diagnostic.h
STUDIO_HOST_SRC := $(wildcard c/apps/gui/studio/core/*.c) c/apps/as/editor/completion.c c/apps/as/common/version.c c/lib/agent/json.c c/lib/agent/task.c c/drivers/block/crc32.c
$(BUILD)/studio-core-test: tests/unit/studio_core_test.c $(STUDIO_HOST_SRC) $(wildcard c/apps/gui/studio/core/*.h)
	@mkdir -p $(BUILD)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -Wall -Wextra -Wno-unused-function -Wno-misleading-indentation -O1 -g -fsanitize=address,undefined tests/unit/studio_core_test.c $(STUDIO_HOST_SRC) -o $@

# Completion consumes the same snapshot and module declarations as checking.
# Run the privacy mutation before its positive target so the gate cannot rot.
test-as-typed test-studio-core: test-as-completion

$(BUILD)/as-lex-recovery-test: tests/unit/as_lex_recovery_test.c c/apps/as/frontend/lexer.c c/apps/as/frontend/lexer.h
	@mkdir -p $(BUILD)
	$(CC) -std=c11 -O1 -g -fsanitize=address,undefined -Ic/apps/as tests/unit/as_lex_recovery_test.c c/apps/as/frontend/lexer.c -o $@
test-as-typed test-as-completion: test-as-recovery

# $(BUILD)/asc-numeric-debug is the compiler unoptimized under ASan/UBSan;
# test-as-completion and test-as-recovery above run against it.
#
# test-as-numeric and test-as-numeric-negctl stood here until 2026-10-26.
# tests/unit/as_numeric_test.py checked the Language-2 integer contract by
# compiling '# aether: 2' programs to .la bytecode with both `asc -c` and the
# self-hosted asc.as (staged by as_migration_test.copy_libraries) and running
# them with -run; its control mutated legacy/vm.c and legacy/bytecode.c. All of
# that left with the A2 engine on 2026-09-16, and as_migration_test.py was never
# committed at all (it belonged to the untracked asmigration work d006fdcc2
# removed), so both targets died at import before any arithmetic ran -- found
# by a host sweep on the macOS dev host, 2026-10-26. A3's integer contract is
# held by test-as-promotion in tests/astyped.mk (mixed-numeric refusal cases at
# O0/O2 under ASan/UBSan) and test-as-promotion-guest on the machine. Both
# scripts were deleted in the same change.
$(BUILD)/asc: c/apps/as/common/numeric.h
$(BUILD)/asc-numeric-debug: $(AS_CORE) c/apps/as/cli/main.c c/apps/as/common/numeric.h c/apps/as/common/diagnostic.h c/apps/as/sema/abi_layout.inc
	@mkdir -p $(BUILD)
	$(CC) -O0 -g -fsanitize=address,undefined -o $@ c/apps/as/cli/main.c $(AS_CORE) -Ic/apps/as -Iinclude/abi -lm
$(BUILD)/asc-numeric-debug: $(AS_HDRS)

# Recording primitives execute the actual Studio renderer, not a copied model.
$(BUILD)/studio-render-test: tests/unit/studio_render_test.c c/apps/gui/studio/core/studio_render.inc c/apps/gui/studio/core/studio_code.inc c/apps/gui/studio/core/studio_completion.inc $(STUDIO_HOST_SRC) $(wildcard c/apps/gui/studio/core/*.h)
	$(CC) -std=c11 -D_DEFAULT_SOURCE -O1 -g -fsanitize=address,undefined -Wno-unused-function tests/unit/studio_render_test.c $(STUDIO_HOST_SRC) -o $@

# The guest gate builds a PRIVATE disk; never overwrite a running desktop.
# Base contains the kernel/fonts' core CLI peers; Studio/AS come from BUILD.
STUDIO_GUEST_BASE ?= build

