build/
*.o
*.elf
*.iso
*.ppm
*.png
.DS_Store

# Python bytecode cache
tools/__pycache__/

# Generated font subsets (proprietary source; regenerated by tools/mkfont.py)
fsroot/fonts/*.ttf

# Third-party LibCSS keeps code-generation scripts under build/ (mkprops.pl,
# conv.pl, make-aliases.pl, Aliases) -- exempt them from the global build/ rule.
!third_party/css/libcss/build/
!third_party/css/libparserutils/build/
