build/
*.o
*.elf
*.iso
*.ppm
*.png
.DS_Store

# Python bytecode cache
# Anywhere, not two named directories: tests/unit/__pycache__ appeared the
# moment a test grew a Python generator, and a listed-by-hand set of paths only
# ever covers the places somebody already tripped over.
__pycache__/

# IDE compilation database (machine-specific paths; regenerate via tools/gen_compile_commands.py)
compile_commands.json

# Codegraph index
.codegraph/
.vscode
.claude
# Redistributable font subsets are tracked; regenerate with `make regen-fonts`.

# Third-party LibCSS keeps code-generation scripts under build/ (mkprops.pl,
# conv.pl, make-aliases.pl, Aliases) -- exempt them from the global build/ rule.
!third_party/css/libcss/build/
!third_party/css/libparserutils/build/

# Wallpaper (Apple Desktop Picture; regenerate via tools/mkwallpaper.sh)
fsroot/wallpaper.png

# Rust (hybrid C+Rust) build artifacts
rust/target/

# Local scratch (WSL helper scripts, baseline worktrees, logs)
.cache/

# API tokens / credentials -- never commit
.env

# Per-line scratch build trees. `build/` was ignored; `build-wm/`, `build-set/`
# and `build-clip/` were not, so three agents left 4,767 files and 159 MB in
# `git status` -- where the real signal (a staged deletion, an uncommitted
# test) has to be found among them.
build-*/
