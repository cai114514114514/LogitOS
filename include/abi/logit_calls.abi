# How AetherScript calls the kernel. THE source for it -- not a copy of one.
#
# include/abi/logit_abi.h defines the syscall NUMBERS and the struct LAYOUTS, and
# both of those are already identities: as_native.c hands the kernel's own SYS_*
# to the script, and every struct offset is asserted against the header at
# compile time. What the header could not express was the CALLING CONVENTION --
# `SYS_GUI_RECT 5 /* ((x<<16)|y, (w<<16)|h, color) */` puts it in a comment, and
# a comment is not checkable. So it was written out by hand three times: here in
# the comment, packed in fsroot/as/lib/gui.as, and unpacked in c/kernel/gui/wm.c.
#
# This file is the one place it is written. tools/gen_abi.py generates from it:
#   fsroot/as/lib/abi.as     the script-side wrappers, which do the packing
#   include/abi/logit_pack.h the kernel-side unpack macros, same fields
# so the two sides cannot disagree about where a field lives.
#
# Syntax, one call per line:
#   call <as_name> <SYS_SYMBOL> <arg>...
# where each arg is one syscall argument (the kernel takes at most 3 after the
# number):
#   int(n)                 passed through unchanged
#   str(s)                 a string; the wrapper passes addr(s)
#   buf(b)                 a buffer or layout; the wrapper passes addr(b)
#   lit(N)                 a constant the caller never supplies
#   pack(f:shift:width,..) bitfields in ONE argument, written high bits first
#
# pack() spells out shift and width rather than inferring them: an ABI source of
# truth should be unambiguous ahead of pretty, and both the pack and the unpack
# fall out of the same three numbers.

# ---- window + drawing (fsroot/as/lib/gui.as is a thin wrapper over these) ----
call gui_create     SYS_GUI_CREATE     str(title) pack(w:16:16, h:0:16)
call gui_clear      SYS_GUI_CLEAR      int(color)
call gui_rect       SYS_GUI_RECT       pack(x:16:16, y:0:16) pack(w:16:16, h:0:16) int(color)
call gui_text       SYS_GUI_TEXT       pack(x:16:16, y:0:16) int(color) str(s)
call gui_text_mono  SYS_GUI_TEXT_MONO  pack(x:16:16, y:0:16) pack(cell:24:8, color:0:24) str(s)
call gui_icon       SYS_GUI_ICON       pack(x:16:16, y:0:16) pack(id:16:16, px:0:16) int(color)
call gui_rrect      SYS_GUI_RRECT      pack(x:16:16, y:0:16) pack(w:16:16, h:0:16) pack(radius:24:8, color:0:24)
# radius is 8 bits, not the 32 the header comment's `(radius<<32)|...` suggests:
# c/kernel/gui/wm.c reads it as (c >> 32) & 0xFF. Writing the convention down is
# what surfaced that -- a shift with no width is exactly the kind of thing a
# comment can leave unsaid and a caller can get wrong.
call gui_glass      SYS_GUI_GLASS      pack(x:16:16, y:0:16) pack(w:16:16, h:0:16) pack(radius:32:8, tr:24:8, tg:16:8, tb:8:8, ta:0:8)
call gui_clip       SYS_GUI_CLIP       pack(x:16:16, y:0:16) pack(w:16:16, h:0:16)
call gui_flush      SYS_GUI_FLUSH
call gui_poll_event SYS_POLL_EVENT     buf(ev)
call ui_dark_query  SYS_UI_DARK        lit(-1)
call ui_dark_set    SYS_UI_DARK        int(on)
call sys_yield      SYS_YIELD
call get_time       SYS_GET_TIME       buf(t)
# The monotonic clock, in milliseconds since boot. Distinct from get_time, which
# is the WALL clock in whole seconds off a CMOS RTC a user can set backwards --
# you cannot measure an interval with that, and await_() below had to say so in a
# comment and then use it anyway. Granularity is 10 ms (100 Hz tick), not 1 ms.
call monotonic_ms   SYS_MONOTONIC_MS

# ---- io / basics ----
call io_write       SYS_WRITE          int(fd) buf(b) int(len)
call proc_exit      SYS_EXIT           int(code)
call get_arg        SYS_GET_ARG        buf(b) int(max)
call sysinfo        SYS_SYSINFO        buf(b) int(max)

# ---- files / directories ----
call file_read      SYS_READ_FILE      str(path) buf(b) int(max)
call file_count     SYS_FILE_COUNT
call file_name      SYS_FILE_NAME      int(i) buf(b) int(max)
call file_write     SYS_WRITE_FILE     str(path) buf(b) int(size)
call file_delete    SYS_DELETE_FILE    str(path)
call file_rename    SYS_RENAME         str(old) str(new)
call dir_make       SYS_MKDIR          str(path)
call dir_count      SYS_DIR_COUNT      str(dir)
call dir_name       SYS_DIR_NAME       str(dir) int(i) buf(b)
call getcwd         SYS_GETCWD         buf(b) int(max)
call chdir          SYS_CHDIR          str(path)

# ---- processes / file descriptors ----
call proc_fork      SYS_FORK
call proc_execve    SYS_EXECVE         str(path) buf(argv) int(envp)
call proc_waitpid   SYS_WAITPID        int(pid) buf(st) int(opts)
call proc_pid       SYS_GETPID
call proc_spawn     SYS_SPAWN          str(path) buf(argv)
call fd_open        SYS_OPEN           str(path) int(flags)
call fd_close       SYS_CLOSE          int(fd)
call fd_read        SYS_READ           int(fd) buf(b) int(len)
call fd_lseek       SYS_LSEEK          int(fd) int(off) int(whence)
call fd_dup         SYS_DUP            int(fd)
call fd_dup2        SYS_DUP2           int(oldfd) int(newfd)
call fd_pipe        SYS_PIPE           buf(fds)
call fd_setnb       SYS_SETNB          int(fd)
call fd_fsync       SYS_FSYNC          int(fd)
call open_path      SYS_OPEN_PATH      str(path)

# ---- network / http / render payloads ----
call net_info       SYS_NET_INFO       buf(ni)
# Non-blocking sockets (M27). port and flags share one argument: the kernel takes
# three, and spending two of them on two 16-bit values would have left nothing for
# a third if one is ever needed. flags is SOCK_F_* -- TLS on/off plus which ALPN
# protocols to offer -- so the ALPN list is an integer here rather than a pointer
# to an array of strings the kernel would have to walk out of user memory.
call sock_open      SYS_SOCK_OPEN      str(host) pack(port:16:16, flags:0:16)
call sock_poll      SYS_SOCK_POLL      int(fd)
call sock_send      SYS_SOCK_SEND      int(fd) buf(b) int(len)
call sock_recv      SYS_SOCK_RECV      int(fd) buf(b) int(max)
call sock_alpn      SYS_SOCK_ALPN      int(fd) buf(b) int(max)
call sock_close     SYS_SOCK_CLOSE     int(fd)
call http_body      SYS_HTTP_BODY      buf(b) int(max)
call res_fetch      SYS_RES_FETCH      str(src) buf(b) int(max)
call text_measure   SYS_TEXT_MEASURE   str(s) int(len) pack(px:1:31, mono:0:1)
call gui_text_run   SYS_GUI_TEXT_RUN   buf(run)
call gui_blit       SYS_GUI_BLIT       buf(blit)
call img_decode     SYS_IMG_DECODE     buf(req)
call cpu_index      SYS_CPU_INDEX
call kheap_stress   SYS_KHEAP_STRESS   int(iters) int(size) int(seed)

# ---- operations you have to wait for ----
#   wait <name> <START> <POLL> <arg>... pending(<pred>) [fail(eq:<value>)]
#                                                     [fail(lt:0)]
#
# Logit has no blocking form for these. The kernel starts the operation and the
# caller polls, because there is no in-kernel wait queue for them -- the NIC is
# polled and net_poll() is pumped from the window manager's loop. So every caller
# wrote its own spin loop, and the two facts that make such a loop correct --
# what "still pending" looks like, and what "failed" looks like -- were in a
# header comment:
#
#   SYS_NET_DNS_RESULT 25 /* -> resolved IP, 0 pending, 0xFFFFFFFF failed */
#
# Stated here instead, they generate the loop, which is then written once rather
# than once per call site with a different magic retry count each time.
#
# pending(eq:V)  still running while the poll returns exactly V
# pending(lt:0)  still running while the poll returns a negative value
# fail(eq:V)     V means the operation failed (absent: failure is indistinguishable
#                from still-pending, so only a timeout can end the wait)
# fail(lt:0)     any negative value means failed (http: the error is a code, not
#                one sentinel, so it cannot be written as eq:)
wait dns  SYS_NET_DNS  SYS_NET_DNS_RESULT  str(name) pending(eq:0)  fail(eq:0xFFFFFFFF)
wait ping SYS_NET_PING SYS_NET_PING_RTT    int(ip)   pending(lt:0)
# HTTP is the same shape: GET starts the fetch, STATUS polls (1 busy, 2 done,
# any negative an error code) -- failure is "anything < 0", not one value.
wait http SYS_HTTP_GET SYS_HTTP_STATUS     str(url)  pending(eq:1)  fail(lt:0)
