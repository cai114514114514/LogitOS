# math -- basic numeric helpers (pure AquaScript stdlib)
#   import math   /   from math import gcd, clamp

PI = 3.141592653589793
E  = 2.718281828459045

def abs(x):
    if x < 0:
        return -x
    return x

def sign(x):
    if x < 0:
        return -1
    if x > 0:
        return 1
    return 0

def max2(a, b):
    if a > b:
        return a
    return b

def min2(a, b):
    if a < b:
        return a
    return b

def clamp(x, lo, hi):
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

def pow(base, exp):                 # integer exponent >= 0
    r = 1
    i = 0
    while i < exp:
        r = r * base
        i = i + 1
    return r

def gcd(a, b):
    a = abs(a)
    b = abs(b)
    while b != 0:
        t = b
        b = a % t
        a = t
    return a

def lcm(a, b):
    if a == 0 or b == 0:
        return 0
    return abs(a * b) / gcd(a, b)   # `/` is integer division for ints

def fact(n):
    r = 1
    i = 2
    while i <= n:
        r = r * i
        i = i + 1
    return r

def isqrt(n):                       # integer floor of sqrt(n), n >= 0
    if n < 2:
        return n
    x = n
    y = (x + 1) / 2
    while y < x:
        x = y
        y = (x + n / x) / 2
    return x
