/* Authoritative language-visible names. Values come from the kernel ABI and
 * capability_bits.h, never duplicated numeric literals. Both the native
 * frontend and the retiring registration code consume this list.
 *
 * Historical registration comments below described an ordinary VM global.
 * Correction: A3 resolves these names after user bindings and lowers them as
 * i64 constants; reading a SYS_* or CAP_* number grants no authority. */
/* M28 capability classes, injected the same way the SYS_* numbers are and
 * for the same reason: a script narrowing a capability has to name the bit
 * it is keeping, and `c.without(32)` is the setcheck.as anti-pattern -- a
 * bare integer with no symbolic name anywhere in the tree. */
AS_SYSTEM_CONSTANT(CAP_FS_READ, AS_CAP_FS_READ)
AS_SYSTEM_CONSTANT(CAP_FS_WRITE, AS_CAP_FS_WRITE)
AS_SYSTEM_CONSTANT(CAP_NET, AS_CAP_NET)
AS_SYSTEM_CONSTANT(CAP_PROC, AS_CAP_PROC)
AS_SYSTEM_CONSTANT(CAP_GUI, AS_CAP_GUI)
AS_SYSTEM_CONSTANT(CAP_RAW, AS_CAP_RAW)

AS_SYSTEM_CONSTANT(SYS_WRITE, SYS_WRITE)
AS_SYSTEM_CONSTANT(SYS_READ, SYS_READ)
AS_SYSTEM_CONSTANT(SYS_OPEN, SYS_OPEN)
AS_SYSTEM_CONSTANT(SYS_CLOSE, SYS_CLOSE)
AS_SYSTEM_CONSTANT(SYS_LSEEK, SYS_LSEEK)
AS_SYSTEM_CONSTANT(SYS_EXIT, SYS_EXIT)
AS_SYSTEM_CONSTANT(SYS_YIELD, SYS_YIELD)
AS_SYSTEM_CONSTANT(SYS_GETPID, SYS_GETPID)
AS_SYSTEM_CONSTANT(SYS_FORK, SYS_FORK)
AS_SYSTEM_CONSTANT(SYS_MKDIR, SYS_MKDIR)
AS_SYSTEM_CONSTANT(SYS_GETCWD, SYS_GETCWD)

/* Settings tools share the kernel's identities. These names grant no access;
 * native capability checks and kernel credential checks still apply. */
AS_SYSTEM_CONSTANT(SYS_SETTING_GET, SYS_SETTING_GET)
AS_SYSTEM_CONSTANT(SYS_SETTING_SET, SYS_SETTING_SET)
AS_SYSTEM_CONSTANT(SYS_SETTING_CTL, SYS_SETTING_CTL)
AS_SYSTEM_CONSTANT(SETCTL_RESET, SETCTL_RESET)
AS_SYSTEM_CONSTANT(SETCTL_DIAG, SETCTL_DIAG)
AS_SYSTEM_CONSTANT(SETCTL_RELOAD, SETCTL_RELOAD)
AS_SYSTEM_CONSTANT(SETCTL_SELFTEST, SETCTL_SELFTEST)
AS_SYSTEM_CONSTANT(SETCTL_KVCOUNT, SETCTL_KVCOUNT)

