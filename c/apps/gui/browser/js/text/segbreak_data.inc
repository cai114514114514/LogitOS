/* 1 iff Extended_Pictographic (emoji/emoji-data.txt). The
 * grapheme rule GB11 and the word rule WB3c both need it as
 * a fact SEPARATE from the class tables: an Extend that is
 * pictographic and one that is not break differently. */
static int seg_is_extpict(uint32_t cp) {
    return seg_extpict_s2[((uint32_t)seg_extpict_s1[cp >> 8] << 8)
                          | (cp & 0xff)] != 0;
}

static int seg_gcb_class(uint32_t cp) {
    return seg_gcb_s2[((uint32_t)seg_gcb_s1[cp >> 8] << 8)
                      | (cp & 0xff)];
}

static int seg_wb_class(uint32_t cp) {
    return seg_wb_s2[((uint32_t)seg_wb_s1[cp >> 8] << 8)
                      | (cp & 0xff)];
}
