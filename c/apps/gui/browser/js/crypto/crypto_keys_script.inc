"    var body=curve<0?der(4,slot.material.d):seq([der(2,new Uint8Array([1])),der(4,slot.material.d),der(161,der(3,catBytes([new Uint8Array([0]),pub])))]);\n"
"    resolve(seq([der(2,new Uint8Array([0])),keyAlgDER(slot.authAlgorithm),der(4,body)]).buffer);return;\n"
"  }\n"
"  resolve(baseExport.call(self,format,key));\n"
"}catch(e){reject(e)}})};\n"
