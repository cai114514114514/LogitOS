"/* 2026-09-10: operational keys replace the historical generateKey refusal.\n"
" * The original symmetric operations remain the shared implementation. Private\n"
" * slots authorize every operation, regardless of mutable public key metadata. */\n"
"var baseImport=SubtleCrypto.prototype.importKey, baseExport=SubtleCrypto.prototype.exportKey;\n"
"var baseSign=SubtleCrypto.prototype.sign, baseVerify=SubtleCrypto.prototype.verify;\n"
"var baseDerive=derive;\n"
"function keyError(name,msg){return new G.DOMException(msg,name)}\n"
"function curveId(alg){return alg.name==='Ed25519'?-1:alg.name==='X25519'?-2:{'P-256':256,'P-384':384,'P-521':521}[alg.namedCurve]||0}\n"
"function pubBytes(m,curve){\n"
"  if(curve<0)return m.x;\n"
"  var p=new Uint8Array(1+m.x.length+m.y.length);p[0]=4;p.set(m.x,1);p.set(m.y,1+m.x.length);return p;\n"
"}\n"
"function sameBytes(a,b){if(a.length!==b.length)return false;var d=0;for(var i=0;i<a.length;i++)d|=a[i]^b[i];return d===0}\n"
"function validateAsymmetric(norm,type,m){\n"
"  if(norm.entry.cls!=='ec' && norm.entry.cls!=='okp')return;\n"
"  var alg={name:norm.name,namedCurve:norm.raw.namedCurve}, curve=curveId(alg), pub=pubBytes(m,curve);\n"
"  if(!curve)throw keyError('NotSupportedError','unknown named curve');\n"
"  try {\n"
"    if(type==='private'){\n"
"      var derived=new Uint8Array(nativeKeyOp(0,curve,m.d.buffer));\n"
"      if(!sameBytes(derived,pub))throw new Error('private and public material disagree');\n"
"    }else nativeKeyOp(4,curve,pub.buffer);\n"
"  }catch(e){throw keyError('DataError','invalid key material')}\n"
"}\n"
"SubtleCrypto.prototype.generateKey=function(algorithm,extractable,usages){return new Promise(function(resolve,reject){try{\n"
"  var norm=normalizeAlg(algorithm), entry=norm.entry;usages=usages?arraySlice(usages):[];\n"
"  var allowed=(entry.usages.secret||[]).concat(entry.usages.public||[],entry.usages.private||[]);\n"
"  if(!usagesOk(usages,allowed)||!usages.length)throw keyError('SyntaxError','invalid key usages');\n"
"  if(entry.cls==='sym'){\n"
"    var bits=norm.raw.length;\n"
"    if(norm.name==='HMAC'){\n"
"      hashSize(norm.hash);bits=bits===undefined?(norm.hash==='SHA-256'?512:1024):uint32(bits,'length');\n"
"    } else {if(bits===undefined)throw new TypeError('AES length is required');bits=uint32(bits,'length');if([128,192,256].indexOf(bits)<0)throw keyError('OperationError','invalid AES length')}\n"
"    if(!bits||bits%8||bits>65536*8)throw keyError('OperationError','key must have a bounded byte length');\n"
"    var bytes=operationFailure(function(){return nativeRandom(bits/8)});\n"
"    resolve(baseImport.call(this,'raw',bytes,algorithm,extractable,usages));return;\n"
"  }\n"
"  if(entry.cls!=='ec'&&entry.cls!=='okp')throw keyError('NotSupportedError','key generation backend unavailable');\n"
"  var alg={name:norm.name};if(entry.cls==='ec'){\n"
"    if(norm.raw.namedCurve===undefined)throw new TypeError('namedCurve is required');alg.namedCurve=norm.raw.namedCurve;\n"
"  }\n"
"  var curve=curveId(alg), n=curve<0?32:EC_FLEN[alg.namedCurve];\n"
"  if(!curve)throw keyError('NotSupportedError','unknown named curve');\n"
"  var priv,pub;\n"
"  for(var i=0;i<8;i++){\n"
"    priv=new Uint8Array(operationFailure(function(){return nativeRandom(n)}));\n"
"    if(curve===521)priv[0]&=1;\n"
"    try{pub=new Uint8Array(nativeKeyOp(0,curve,priv.buffer));break}catch(e){priv.fill(0);if(i===7)throw keyError('OperationError','key generation failed')}\n"
"  }\n"
"  var m=curve<0?{x:pub}:{x:pub.slice(1,1+n),y:pub.slice(1+n)};\n"
"  var pubUs=usages.filter(function(u){return arrayIndexOf(entry.usages.public,u)>=0});\n"
"  var privUs=usages.filter(function(u){return arrayIndexOf(entry.usages.private,u)>=0});\n"
"  if(!privUs.length)throw keyError('SyntaxError','private key requires a usage');\n"
"  var privateMat={x:m.x.slice(),d:priv};if(m.y)privateMat.y=m.y.slice();\n"
"  resolve({publicKey:makeCryptoKey('public',true,{name:alg.name,namedCurve:alg.namedCurve},pubUs,m),\n"
"    privateKey:makeCryptoKey('private',extractable,alg,privUs,privateMat)});\n"
"}catch(e){reject(e)}})};\n"
"SubtleCrypto.prototype.sign=function(algorithm,key,data){return new Promise(function(resolve,reject){try{\n"
"  var norm=operationAlg(algorithm);if(norm.name!=='Ed25519'&&norm.name!=='ECDSA'){resolve(baseSign.call(this,algorithm,key,data));return}\n"
"  var slot=checkKeyFor(key,norm.name,'sign'),msg=bufferCopy(data);\n"
"  if(slot.type!=='private')throw keyError('InvalidAccessError','private key required');\n"
"  if(norm.name==='ECDSA'){if(norm.raw.hash===undefined)throw new TypeError('hash is required');msg=nativeDigest(normalizeDigest(norm.raw.hash),msg)}\n"
"  resolve(operationFailure(function(){return nativeKeyOp(1,curveId(slot.authAlgorithm),slot.material.d.buffer,msg)}));\n"
"}catch(e){reject(e)}})};\n"
"SubtleCrypto.prototype.verify=function(algorithm,key,signature,data){return new Promise(function(resolve,reject){try{\n"
"  var norm=operationAlg(algorithm);if(norm.name!=='Ed25519'&&norm.name!=='ECDSA'){resolve(baseVerify.call(this,algorithm,key,signature,data));return}\n"
"  var slot=checkKeyFor(key,norm.name,'verify'),msg=bufferCopy(data),sig=bufferCopy(signature),curve=curveId(slot.authAlgorithm);\n"
"  if(slot.type!=='public')throw keyError('InvalidAccessError','public key required');\n"
"  if(norm.name==='ECDSA'){if(norm.raw.hash===undefined)throw new TypeError('hash is required');msg=nativeDigest(normalizeDigest(norm.raw.hash),msg)}\n"
"  resolve(operationFailure(function(){return nativeKeyOp(2,curve,pubBytes(slot.material,curve).buffer,msg,sig)}));\n"
"}catch(e){reject(e)}})};\n"
"derive=function(algorithm,key,length,usage){\n"
"  var norm=operationAlg(algorithm);if(norm.name!=='ECDH'&&norm.name!=='X25519')return baseDerive(algorithm,key,length,usage);\n"
"  var slot=checkKeyFor(key,norm.name,usage),pub=slotOf(norm.raw.public);\n"
"  if(slot.type!=='private'||pub.type!=='public'||pub.authAlgorithm.name!==norm.name||pub.authAlgorithm.namedCurve!==slot.authAlgorithm.namedCurve)\n"
"    throw keyError('InvalidAccessError','incompatible public key');\n"
"  var curve=curveId(slot.authAlgorithm),raw=operationFailure(function(){return nativeKeyOp(3,curve,slot.material.d.buffer,pubBytes(pub.material,curve).buffer)});\n"
"  if(length===null||length===undefined)return raw;\n"
"  var bits=uint32(length,'length');if(bits>raw.byteLength*8)throw keyError('OperationError','requested too many shared-secret bits');\n"
"  var out=new Uint8Array(raw.slice(0,Math.ceil(bits/8)));if(bits%8)out[out.length-1]&=255<<(8-bits%8);return out.buffer;\n"
"};\n"
"/* DER is strict and bounded: parse the complete object, verify the algorithm\n"
" * OID and curve, and reject unconsumed bytes. Only EC and RFC 8410 OKP formats\n"
" * are implemented here; RSA still has no private-key operation backend. */\n"
"function catBytes(parts){var n=0;parts.forEach(function(p){n+=p.length});var b=new Uint8Array(n),o=0;parts.forEach(function(p){b.set(p,o);o+=p.length});return b}\n"
"function der(tag,b){var n=b.length,l=n<128?[n]:n<256?[129,n]:[130,n>>8,n&255];return catBytes([new Uint8Array([tag].concat(l)),b])}\n"
"function seq(parts){return der(48,catBytes(parts))}\n"
"var EC_OID=new Uint8Array([42,134,72,206,61,2,1]);\n"
"var CURVE_OID={'P-256':[42,134,72,206,61,3,1,7],'P-384':[43,129,4,0,34],'P-521':[43,129,4,0,35]};\n"
"function keyAlgDER(alg){return alg.name==='Ed25519'||alg.name==='X25519'?seq([der(6,new Uint8Array([43,101,alg.name==='Ed25519'?112:110]))]):\n"
" seq([der(6,EC_OID),der(6,new Uint8Array(CURVE_OID[alg.namedCurve]))])}\n"
"function derReader(bytes){return {b:bytes,p:0,take:function(tag){\n"
"  var b=this.b,p=this.p;if(p+2>b.length||b[p++]!==tag)throw keyError('DataError','invalid DER tag');\n"
"  var n=b[p++];if(n&128){var k=n&127;if(!k||k>2||p+k>b.length||b[p]===0)throw keyError('DataError','invalid DER length');n=0;while(k--)n=n*256+b[p++];if(n<128)throw keyError('DataError','nonminimal DER length')}\n"
"  if(n>b.length-p)throw keyError('DataError','truncated DER');this.p=p+n;return b.slice(p,p+n);\n"
" },end:function(){if(this.p!==this.b.length)throw keyError('DataError','trailing DER data')}}}\n"
"function readDER(format,bytes,norm){\n"
"  if(bytes.length>2048)throw keyError('DataError','key DER too large');\n"
"  var outer=derReader(bytes),r=derReader(outer.take(48));outer.end();\n"
"  if(format==='pkcs8'){var version=r.take(2);if(version.length!==1||version[0]!==0)throw keyError('DataError','unsupported PrivateKeyInfo version')}\n"
"  var alg={name:norm.name,namedCurve:norm.raw.namedCurve};\n"
"  var got=der(48,r.take(48));if(!sameBytes(got,keyAlgDER(alg)))throw keyError('DataError','key algorithm or curve mismatch');\n"
"  var key=r.take(format==='spki'?3:4);r.end();var curve=curveId(alg),m;\n"
"  if(format==='spki'){\n"
"    if(key[0]!==0)throw keyError('DataError','invalid public BIT STRING');m=parseRaw(norm.entry,norm.name,key.slice(1),norm.raw);\n"
"  }else{\n"
"    var priv;\n"
"    if(curve<0){var kr=derReader(key);priv=kr.take(4);kr.end()}\n"
"    else{\n"
"      var ko=derReader(key),kr=derReader(ko.take(48));ko.end();var v=kr.take(2);if(v.length!==1||v[0]!==1)throw keyError('DataError','invalid ECPrivateKey version');priv=kr.take(4);\n"
"      if(kr.p<kr.b.length&&kr.b[kr.p]===160){var params=derReader(kr.take(160));if(!sameBytes(params.take(6),new Uint8Array(CURVE_OID[alg.namedCurve])))throw keyError('DataError','EC curve mismatch');params.end()}\n"
"      var advertised=null;if(kr.p<kr.b.length&&kr.b[kr.p]===161){var pr=derReader(kr.take(161));advertised=pr.take(3);pr.end()}kr.end();\n"
"    }\n"
"    var n=curve<0?32:EC_FLEN[alg.namedCurve];if(priv.length!==n)throw keyError('DataError','invalid private key length');\n"
"    var publicBytes;try{publicBytes=new Uint8Array(nativeKeyOp(0,curve,priv.buffer))}catch(e){throw keyError('DataError','invalid private key')}\n"
"    if(advertised && (advertised[0]!==0||!sameBytes(advertised.slice(1),publicBytes)))throw keyError('DataError','EC public key mismatch');\n"
"    m=curve<0?{x:publicBytes,d:priv}:{x:publicBytes.slice(1,1+n),y:publicBytes.slice(1+n),d:priv};\n"
"  }\n"
"  var jwk={kty:curve<0?'OKP':'EC',crv:curve<0?norm.name:alg.namedCurve,x:b64urlEncode(m.x)};\n"
"  if(m.y)jwk.y=b64urlEncode(m.y);if(m.d)jwk.d=b64urlEncode(m.d);return jwk;\n"
"}\n"
"SubtleCrypto.prototype.importKey=function(format,keyData,algorithm,extractable,usages){\n"
"  if(format!=='spki'&&format!=='pkcs8')return baseImport.call(this,format,keyData,algorithm,extractable,usages);\n"
"  var self=this;return new Promise(function(resolve,reject){try{\n"
"    var norm=normalizeAlg(algorithm);if(norm.entry.cls!=='ec'&&norm.entry.cls!=='okp')throw keyError('NotSupportedError','DER algorithm unavailable');\n"
"    var type=format==='spki'?'public':'private',requested=usages?arraySlice(usages):[];\n"
"    if(!usagesOk(requested,norm.entry.usages[type])||(type==='private'&&!requested.length))throw keyError('SyntaxError','invalid key usages');\n"
"    if(norm.entry.cls==='ec'&&!EC_FLEN[norm.raw.namedCurve])throw keyError('NotSupportedError','unknown named curve');\n"
"    resolve(baseImport.call(self,'jwk',readDER(format,new Uint8Array(bufferCopy(keyData)),norm),algorithm,extractable,requested));\n"
"  }catch(e){reject(e)}})\n"
"};\n"
"SubtleCrypto.prototype.exportKey=function(format,key){var self=this;return new Promise(function(resolve,reject){try{\n"
"  var slot=slotOf(key),entry=ALG[slot.authAlgorithm.name];\n"
"  if(!slot.extractable)throw keyError('InvalidAccessError','key is not extractable');\n"
"  if(entry.cls!=='ec'&&entry.cls!=='okp'){resolve(baseExport.call(self,format,key));return}\n"
"  var curve=curveId(slot.authAlgorithm),pub=pubBytes(slot.material,curve);\n"
"  if(format==='raw'){if(slot.type!=='public')throw keyError('InvalidAccessError','raw requires a public key');resolve(pub.slice().buffer);return}\n"
"  if(format==='spki'){\n"
"    if(slot.type!=='public')throw keyError('InvalidAccessError','SPKI requires a public key');\n"
"    resolve(seq([keyAlgDER(slot.authAlgorithm),der(3,catBytes([new Uint8Array([0]),pub]))]).buffer);return;\n"
"  }\n"
"  if(format==='pkcs8'){\n"
